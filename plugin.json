{
  "id": "usage",
  "kind": "source",
  "version": "1.0.7",
  "hub_api": 1,
  "name": {
    "zh": "AI 用量",
    "en": "AI usage"
  },
  "description": {
    "zh": "Cursor、Trae、Qoder、Open Design、OpenCode Go、AGY、Devin 的已用百分比",
    "en": "Percent used for Cursor, Trae, Qoder, Open Design, OpenCode Go, AGY and Devin"
  },
  "author": "neatstudio",
  "homepage": "https://github.com/neatstudio/glance-plugin-usage",
  "license": "MIT",
  "entry": "plugin.py",
  "permissions": [
    "network",
    "filesystem:data",
    "secrets:opencode",
    "secrets:opencode_go",
    "secrets:devin",
    "secrets:devin_seat_url",
    "secrets:agy_client_id",
    "secrets:agy_client_secret"
  ],
  "settings": {
    "type": "object",
    "properties": {
      "refresh_min": {
        "type": "integer",
        "default": 5,
        "minimum": 1,
        "maximum": 120,
        "title": "刷新间隔（分钟）"
      },
      "providers": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "CURSOR",
          "TRAE",
          "QODER",
          "DESIGN",
          "OC.GO",
          "AGY",
          "DEVIN"
        ],
        "title": "显示哪些（按顺序）"
      }
    }
  },
  "provides": {
    "entities": [
      {
        "id": "rows",
        "name": {
          "zh": "用量表"
        },
        "fields": {
          "rows": {
            "type": "table",
            "columns": [
              "name",
              "pct_5h",
              "pct_week",
              "tag_5h",
              "tag_week",
              "note"
            ]
          },
          "lines": {
            "type": "list"
          },
          "names": {
            "type": "list"
          }
        },
        "stale_after_s": 1800
      },
      {
        "id": "trae",
        "name": { "zh": "Trae" },
        "fields": {
          "pct_5h": { "type": "number", "unit": "%" },
          "pct_week": { "type": "number", "unit": "%" },
          "line": { "type": "text" }
        },
        "stale_after_s": 1800
      },
      {
        "id": "qoder",
        "name": { "zh": "Qoder" },
        "fields": {
          "pct_5h": { "type": "number", "unit": "%" },
          "pct_week": { "type": "number", "unit": "%" },
          "line": { "type": "text" }
        },
        "stale_after_s": 1800
      },
      {
        "id": "cursor",
        "name": {
          "zh": "Cursor"
        },
        "fields": {
          "pct_5h": {
            "type": "number",
            "unit": "%"
          },
          "pct_week": {
            "type": "number",
            "unit": "%"
          },
          "line": {
            "type": "text"
          }
        },
        "stale_after_s": 1800
      },
      {
        "id": "opendesign",
        "name": {
          "zh": "Open Design"
        },
        "fields": {
          "pct_5h": {
            "type": "number",
            "unit": "%"
          },
          "pct_week": {
            "type": "number",
            "unit": "%"
          },
          "line": {
            "type": "text"
          }
        },
        "stale_after_s": 1800
      },
      {
        "id": "ocgo",
        "name": {
          "zh": "OpenCode Go"
        },
        "fields": {
          "pct_5h": {
            "type": "number",
            "unit": "%"
          },
          "pct_week": {
            "type": "number",
            "unit": "%"
          },
          "line": {
            "type": "text"
          }
        },
        "stale_after_s": 1800
      },
      {
        "id": "agy",
        "name": {
          "zh": "Antigravity"
        },
        "fields": {
          "pct_5h": {
            "type": "number",
            "unit": "%"
          },
          "pct_week": {
            "type": "number",
            "unit": "%"
          },
          "line": {
            "type": "text"
          }
        },
        "stale_after_s": 1800
      },
      {
        "id": "devin",
        "name": {
          "zh": "Devin"
        },
        "fields": {
          "pct_5h": {
            "type": "number",
            "unit": "%"
          },
          "pct_week": {
            "type": "number",
            "unit": "%"
          },
          "line": {
            "type": "text"
          }
        },
        "stale_after_s": 1800
      }
    ]
  }
}
